{
  "name": "nas-artifacts",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, tailnet-only artifact publishing: HTML/Markdown pages with versions, assets and page capabilities.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "DATA_DIR=.data ARTIFACTS_TOKENS=dev-token node --watch src/server.ts",
    "tc": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@simplewebauthn/server": "14.1.0",
    "highlight.js": "11.12.0",
    "hono": "4.13.18",
    "marked": "18.2.0",
    "marked-alert": "2.1.2",
    "marked-footnote": "1.4.0",
    "pele": "1.13.0",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.21.0"
}
